# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# The whole directory, not just the extensions above. `scripts/mint_token.py`
# writes the JWT signing key here, and `SCHEDULER_JWT_PRIVATE_KEY_PATH` points at
# it. The .pem rule already covered those two files -- but a secret written here
# with no extension (a bare token, a JSON credential) would NOT have been ignored,
# and this repo is worked on with `git add -A`. Found during the VERIFY step 5 pass.
.secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Node
node_modules/
.next/

# OS
.DS_Store

# Logs
*.log
.coverage
htmlcov/

# Agent governance zones. Per-commit machine output, ignored for the same reason
# `.verify-receipt.json` was -- which is the artifact these replace, so that name is
# deliberately gone rather than left behind for a future session to read as current.
# `zones/README.md` is the tracked part: it documents the contract, not a verdict.
zones/claimed/
zones/verified/

# Personal Claude Code overrides. `.claude/settings.json` IS committed -- it carries
# the permission deny list and the hooks, which are project policy rather than taste.
.claude/settings.local.json

# The runner symlink is created by install.sh (setup_executables), so it is a build
# artifact and was never a source file. It had been TRACKED and DANGLING since the
# 2026-08-04 monorepo migration, pointing at `Node/.venv/bin/public-intelligence-node`
# -- a path that migration deleted. Every fresh clone therefore got a broken link,
# and it broke naive recursive copies of the tree. Found during the ROADMAP 3.5 work.
public-intelligence-node

# Website environment written by install.sh with the node's credential (ROADMAP 3.5).
packages/website/.env.local

# Default Scheduler state file (ROADMAP C3 turned persistence on by default).
scheduler-state.db
scheduler-state.db-*
