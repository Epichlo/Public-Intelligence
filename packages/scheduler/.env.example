# Public Intelligence Scheduler — Environment Configuration
# Copy this file to .env and modify as needed.

# Deployment environment: development, staging, production
SCHEDULER_ENVIRONMENT=development

# Enable debug mode
SCHEDULER_DEBUG=false

# Log level: debug, info, warning, error, critical
SCHEDULER_LOG_LEVEL=info

# Server bind address and port
SCHEDULER_HOST=0.0.0.0
SCHEDULER_PORT=8000

# --- Durable state (ROADMAP 2.1) ---------------------------------------------
#
# SQLite file holding registered nodes, their per-node control credentials, and
# credit balances. UNSET (the default) means every restart starts empty: nodes
# re-register themselves within a minute, but credit balances are gone for good.
#
#   SCHEDULER_DATABASE_PATH=./data/scheduler.db
#
# READ THIS BEFORE RELYING ON IT. Render's free tier has an ephemeral filesystem.
# A file here survives a process restart inside the same container and is WIPED BY
# EVERY REDEPLOY. That is durability that looks like it works and does not, which
# is why this defaults to off rather than to a path. On Render you need a
# persistent disk, or a Postgres backend that does not exist yet.
#
# The Scheduler logs `persistence_enabled` and the resolved path at startup. Check
# the log, not this comment -- a comment cannot notice when it goes stale.
#
# The file holds per-node credentials in plaintext, exactly as process memory does
# today. File permissions are the control.
