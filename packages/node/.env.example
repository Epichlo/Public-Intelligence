# API Bind Configuration
NODE_HOST=0.0.0.0
NODE_PORT=8000

# Scheduler Configuration
NODE_SCHEDULER_URL=http://localhost:8080

# Ollama Configuration
NODE_OLLAMA_HOST=http://localhost:11434

# Node Configuration
NODE_NODE_ID=node-local
NODE_HOSTNAME=localhost
NODE_REGION=local
NODE_HEARTBEAT_INTERVAL_SECONDS=30

# Which models this node serves is NOT configured here -- it is whatever Ollama
# has pulled, read at startup and re-read on this interval so that `ollama pull`
# and `ollama rm` reach the Scheduler without a restart.
NODE_MODEL_REFRESH_INTERVAL_SECONDS=60

# Logging Configuration
NODE_LOG_LEVEL=INFO

# Environment Configuration
NODE_DEBUG=false

# --- Browser access (ROADMAP 2.3) --------------------------------------------
#
# Origins allowed to read this Node's responses cross-origin. UNSET (the default)
# installs no CORS middleware at all. The dashboard reaches this service through
# the website's server-side proxy, never from your browser, so leave it unset
# unless you serve a browser UI from another origin on this machine.
#
#   NODE_CORS_ALLOW_ORIGINS=http://localhost:3000
#
# Setting it to `*` is a startup ERROR: with credentials enabled Starlette
# reflects the caller's Origin rather than sending a wildcard, which made this
# Node readable from any page you visited. See specs/close-the-open-http-surface.md.
