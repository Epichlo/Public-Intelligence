# API Bind Configuration
NODE_HOST=0.0.0.0
NODE_PORT=8000

# Scheduler Configuration
NODE_SCHEDULER_URL=http://localhost:8080

# Ollama Configuration
NODE_OLLAMA_HOST=http://localhost:11434

# Node Configuration
NODE_NODE_ID=node-local
NODE_HOSTNAME=localhost
NODE_REGION=local
NODE_HEARTBEAT_INTERVAL_SECONDS=30

# Which models this node serves is NOT configured here -- it is whatever Ollama
# has pulled, read at startup and re-read on this interval so that `ollama pull`
# and `ollama rm` reach the Scheduler without a restart.
NODE_MODEL_REFRESH_INTERVAL_SECONDS=60

# Logging Configuration
NODE_LOG_LEVEL=INFO

# Environment Configuration
NODE_DEBUG=false
