{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "claude-code": {
      "type": "local",
      "command": ["/opt/homebrew/bin/claude", "mcp", "serve"],
      "enabled": true,
      "timeout": 300000
    }
  },
  "permission": {
    "read": "allow",
    "edit": {
      ".env": "deny",
      ".env.*": "deny",
      "*.pem": "deny",
      ".secrets/**": "deny",
      "zones/verified/**": "deny",
      ".claude/hooks/**": "deny",
      "**": "allow"
    },
    "bash": "allow",
    "external_directory": "ask"
  }
}
