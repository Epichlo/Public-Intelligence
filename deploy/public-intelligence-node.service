[Unit]
Description=Public Intelligence Node Compute Worker
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=pi-node
Group=pi-node
WorkingDirectory=/Users/atharvdeshpande/Desktop/Public-Intelligence/Node
EnvironmentFile=/Users/atharvdeshpande/Desktop/Public-Intelligence/Node/.env
ExecStart=/Users/atharvdeshpande/Desktop/Public-Intelligence/Node/.venv/bin/python -m uvicorn node.main:app --host 0.0.0.0 --port 8000

# Process and resource limits
LimitNOFILE=65535
LimitNPROC=4096
LimitMEMLOCK=infinity
TasksMax=8192

# Automatic restart on failure configuration
Restart=on-failure
RestartSec=5s

# Execution security and isolation constraints
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
